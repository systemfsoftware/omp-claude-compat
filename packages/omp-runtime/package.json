{
  "name": "@systemfsoftware/omp-runtime",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "description": "OMP extension runtime: bootstrap a shared ManagedRuntime under the host load model — signal disposal, warm-after-start, lazy runSafe",
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/mod.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsdown",
    "typecheck": "tsc --noEmit --incremental",
    "test": "vitest run --passWithNoTests",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@systemfsoftware/tsconfig": "^1.3.3",
    "@types/node": "^24",
    "effect": "^4.0.0-rc.112",
    "oxlint": "^1.77.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^7",
    "vitest": "^4"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.112"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/omp-claude-compat.git",
    "directory": "packages/omp-runtime"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}
