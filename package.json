{
  "name": "omp-claude-compat",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json --noEmit",
    "test": "pnpm -r test",
    "mutation": "pnpm -r mutation",
    "lint": "pnpm -r lint",
    "format": "./bin/dprint fmt",
    "format:check": "./bin/dprint check",
    "precommit": "pnpm exec lint-staged --no-revert --config .lintstagedrc.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@systemfsoftware/all": "^1.1.3",
    "@systemfsoftware/tsconfig": "^1.3.3",
    "@types/node": "^24",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7"
  },
  "packageManager": "pnpm@11.21.0"
}
