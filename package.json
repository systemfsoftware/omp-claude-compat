{
  "name": "@systemfsoftware/omp-claude-compat",
  "license": "Apache-2.0",
  "version": "5.0.0",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "description": "OMP Claude Code compatibility: dispatch .claude/settings.json and enabled plugin hooks/hooks.json hooks + inject CLAUDE.md @-references",
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @systemfsoftware/harness-toml --filter @systemfsoftware/omp-runtime run build && rimraf dist && tsdown",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit --incremental",
    "attw": "attw --pack .",
    "test": "vitest run --passWithNoTests",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}"
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.0.0-rc.112",
    "@oh-my-pi/pi-coding-agent": "^17.0.5",
    "effect": "^4.0.0-rc.112"
  },
  "optionalDependencies": {
    "@systemfsoftware/effect-cell-types": "^6.0.1",
    "@systemfsoftware/harness-toml": "workspace:^",
    "@systemfsoftware/omp-runtime": "workspace:^"
  },
  "devDependencies": {
    "@effect/platform-node": "^4.0.0-rc.112",
    "@effect/platform-node-shared": "^4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@oh-my-pi/pi-coding-agent": "^17.0.5",
    "@systemfsoftware/arethetypeswrong-cli": "^4.0.0",
    "@systemfsoftware/effect-gherkin-spec": "^4.0.1",
    "@systemfsoftware/effect-memfs": "^1.3.4",
    "@systemfsoftware/effect-schema-law": "^2.0.2",
    "@systemfsoftware/effect-schema-vite": "^2.0.3",
    "@systemfsoftware/harness-toml": "workspace:^",
    "@systemfsoftware/omp-runtime": "workspace:^",
    "@systemfsoftware/oxlint-plugin-cell-vocabulary": "^2.0.1",
    "@systemfsoftware/stryker-js-cli": "^6.0.0",
    "@systemfsoftware/stryker-js-typescript-checker": "^5.0.0",
    "@systemfsoftware/stryker-js-vitest-runner": "^4.0.0",
    "@systemfsoftware/stryker-plugins": "^3.0.0",
    "@systemfsoftware/stryker-test-contribution": "^2.0.0",
    "@systemfsoftware/tsconfig": "^1.3.3",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^4",
    "effect": "^4.0.0-rc.112",
    "fast-check": "^4",
    "oxlint": "^1.77.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^7",
    "vitest": "^4",
    "oxlint-tsgolint": "7.0.2001"
  },
  "omp": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "provenance": true
  },
  "inlinedDependencies": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@jsr/std__collections": "1.3.0",
    "@jsr/std__toml": "1.0.11",
    "@systemfsoftware/effect-cell-types": "6.0.1",
    "effect": "4.0.0-rc.112"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/systemfsoftware/omp-claude-compat.git"
  }
}
